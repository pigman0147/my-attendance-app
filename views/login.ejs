<!DOCTYPE html>
<html>
<head><title>Login</title></head>
<body style="text-align:center; padding-top:50px; font-family:sans-serif;">
    <h2>🔐 เข้าสู่ระบบเช็คชื่อ</h2>
    <% if (error) { %> <p style="color:red;"><%= error %></p> <% } %>
    
    <form action="/login" method="post">
        <input type="text" name="username" placeholder="Username" required style="padding:10px;"><br><br>
        <input type="password" name="password" placeholder="Password" required style="padding:10px;"><br><br>
        <button type="submit" style="padding:10px 20px;">เข้าสู่ระบบ</button>
    </form>
</body>
</html>