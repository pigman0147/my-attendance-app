<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>จัดการลงเวลา/เหตุผล</title>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Sarabun', sans-serif; background-color: #f0f2f5; padding: 20px; }
        .container { max-width: 1000px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }

        /* Header */
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 15px; }
        .btn-back { background: #6c757d; color: white; text-decoration: none; padding: 8px 15px; border-radius: 5px; font-size: 14px; }

        /* Date Picker */
        .date-control { background: #e9ecef; padding: 15px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
        input[type="date"] { padding: 8px; border: 1px solid #ccc; border-radius: 5px; font-family: 'Sarabun'; }
        .btn-filter { background: #007bff; color: white; border: none; padding: 8px 15px; border-radius: 5px; cursor: pointer; }

        /* Table */
        table { width: 100%; border-collapse: collapse; }
        th { background: #f8f9fa; text-align: left; padding: 12px; border-bottom: 2px solid #ddd; }
        td { padding: 10px 12px; border-bottom: 1px solid #eee; vertical-align: middle; }
        tr:hover { background-color: #f1f1f1; }

        /* Inputs in Table */
        select, input[type="text"], input[type="time"] {
            padding: 8px; border: 1px solid #ddd; border-radius: 5px; width: 100%; box-sizing: border-box; font-family: 'Sarabun';
        }
        select { background: white; }
        .input-remark { width: 100%; min-width: 150px; }

        /* Save Button */
        .btn-save { background: #28a745; color: white; border: none; padding: 8px 12px; border-radius: 5px; cursor: pointer; width: 100%; }
        .btn-save:hover { background: #218838; }

        /* Status Colors */
        .status-present { color: green; font-weight: bold; }
        .status-absent { color: red; font-weight: bold; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h2 style="margin:0;">📝 บันทึกเหตุผล / แก้ไขเวลา</h2>
        <a href="/admin" class="btn-back">⬅️ กลับหน้าหลัก</a>
    </div>

    <form class="date-control" method="GET" action="/admin/manage">
        <label>เลือกวันที่ต้องการจัดการ:</label>
        <input type="date" name="date" value="<%= date %>" required>
        <button type="submit" class="btn-filter">ค้นหา</button>
    </form>

    <table>
        <thead>
            <tr>
                <th width="20%">ชื่อพนักงาน</th>
                <th width="15%">สถานะ</th>
                <th width="15%">เวลาเข้า</th>
                <th width="15%">เวลาออก</th>
                <th width="25%">เหตุผล / หมายเหตุ</th>
                <th width="10%">บันทึก</th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(row => { %>
                <tr>
                    <form action="/admin/update-status" method="POST">
                        <input type="hidden" name="userId" value="<%= row.id %>">
                        <input type="hidden" name="date" value="<%= date %>">

                        <td style="font-weight: bold; color: #333;"><%= row.name %></td>

                        <td>
                            <select name="status">
                                <option value="ปกติ" <%= !row.leave_type ? 'selected' : '' %>>✅ มาทำงาน</option>
                                <option value="ลาป่วย" <%= row.leave_type == 'ลาป่วย' ? 'selected' : '' %>>😷 ลาป่วย</option>
                                <option value="ลากิจ" <%= row.leave_type == 'ลากิจ' ? 'selected' : '' %>>📝 ลากิจ</option>
                                <option value="พักร้อน" <%= row.leave_type == 'พักร้อน' ? 'selected' : '' %>>🏖️ พักร้อน</option>
                                <option value="ขาดงาน" <%= row.leave_type == 'ขาดงาน' ? 'selected' : '' %>>❌ ขาดงาน</option>
                                <option value="อื่นๆ" <%= row.leave_type == 'อื่นๆ' ? 'selected' : '' %>>❓ อื่นๆ</option>
                            </select>
                        </td>

                        <td><input type="text" name="checkIn" value="<%= row.check_in_time || '' %>" placeholder="00:00:00"></td>

                        <td><input type="text" name="checkOut" value="<%= row.check_out_time || '' %>" placeholder="00:00:00"></td>

                        <td>
                            <input type="text" name="remark" class="input-remark"
                                   value="<%= row.remark || '' %>" placeholder="เช่น ป่วยเป็นไข้หวัด, รถเสีย">
                        </td>

                        <td><button type="submit" class="btn-save">💾 บันทึก</button></td>
                    </form>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>

</body>
</html>
